wget https://repo1.maven.org/maven2/net/sf/saxon/Saxon-HE/12.7/Saxon-HE-12.7.jar
unzip -q Saxon-HE-12.7.jar -d JAR
cd JAR
rm META-INF/services/javax.xml.transform.TransformerFactory
rm -f META-INF/TE*
# rimuovo le firme originali poichè viene ridistrubuito con modifiche
rm -f META-INF/SAXON.RSA  
rm -f META-INF/SAXON.SF
rm -f META-INF/MANIFEST.MF
jar -cf ../Saxon-HE-12.7-gov4j-1.jar *
cd ..
rm -rf JAR
