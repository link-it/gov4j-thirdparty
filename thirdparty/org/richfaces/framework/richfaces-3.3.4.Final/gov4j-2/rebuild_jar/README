16) cd ..


# A questo punto La nuova versione della libreria impl si trovera' sotto framework/impl/target

17) Nel caso di patch Standard eseguire i seguenti comandi:
	
cp framework/impl/target/richfaces-impl-3.3.4.Final.jar ../richfaces-impl-3.3.4.Final-gov4j-2.jar;

cd ..	
unzip richfaces-impl-3.3.4.Final-gov4j-2.jar -d JAR
cp patch/standard/JSFAJAX.js.patch JAR
rm richfaces-impl-3.3.4.Final-gov4j-2.jar
cd JAR
jar -cfM ../richfaces-impl-3.3.4.Final-gov4j-2.jar *
cd ..
rm -rf JAR

cp richfaces-impl-3.3.4.Final-gov4j-2.jar ../../jar/faces/richfaces-impl-3.3.4.Final-gov4j-2.jar;


18) Nel caso di patch IIS invece:

     cp framework/impl/target/richfaces-impl-3.3.4.Final.jar ../richfaces-impl-3.3.4.Final_IIS-gov4j-2.jar


# La compilazione dalla libreria ui prosegue:

19) cd richfaces-ui-3.3.4.Final/ui

20) vi pom.xml
21) escludere la dipendenza dei test :

<!-- 		<dependency> -->
<!-- 			<groupId>org.richfaces.framework</groupId> -->
<!-- 			<artifactId>richfaces-test</artifactId> -->
<!-- 			<version>3.3.4.Final</version> -->
<!-- 			<scope>test</scope> -->
<!-- 		</dependency> -->

22) salvare le modifiche.

# ci sono da correggere alcuni errori di compilazione, giusto per far generare il jar dal quale estrarremo il js finale.

23) vi state/src/main/java/org/richfaces/ui/application/StateApplication.java
24) alla riga 64 sostituire:

                this.exprFactory = null;
//                              new StateExpressionFactory(){
//                      @Override
//                      public ExpressionFactory getDefaultFactory() {
//                              return parent.getExpressionFactory();
//                      }
//              };

25) salvare le modifiche.

26) vi state/src/main/java/org/richfaces/ui/application/StateExpressionFactory.java
27) commentare tutti i metodi presenti nella classe tranne l'ultimo:


        /**
         * @return the defaultFactory
         */
        public abstract ExpressionFactory getDefaultFactory() ;

28) salvare le modifiche.

# compilazione del progetto ui

NOTA: prima impostare nella shell:
export MAVEN_OPTS="-Xmx1024m -XX:MaxPermSize=1024m"

29) mvn clean install -Dmaven.test.skip=true

# a questo punto abbiamo completato la generazione delle risorse necessarie al jar ui

30) cd assembly

# N.B. --> utilizzare mvn versione 2.2.1 o la build schianta

31) vi pom.xml
32) indicare la versione di questo plugin :
<!-- append extracted sources , for pack with library -->
	<plugin>
		<groupId>org.codehaus.mojo</groupId>
		<artifactId>build-helper-maven-plugin</artifactId>

		<version>1.4</version> 

		<executions>

33) mvn clean install -Dmaven.test.skip=true

# il nuovo jar si trova in target/dist/richfaces-ui-3.3.4.Final.jar
# estraiamo il file js necessario

34) mkdir build

35) cd build

36) unzip ../target/dist/richfaces-ui-3.3.4.Final.jar org/richfaces/ui.pack.js

# Copia del vecchio vecchio file ui:

37) cp ../../../../richfaces-ui-3.3.4.Final.jar richfaces-ui-3.3.4.Final-gov4j-2.jar 

# aggiorno i file necessari

38) cp ../../../../patch/ui/* .
    zip -r richfaces-ui-3.3.4.Final-gov4j-2.jar org/
    zip -r richfaces-ui-3.3.4.Final-gov4j-2.jar RichfacesUI-Combobox.patch
    zip -r richfaces-ui-3.3.4.Final-gov4j-2.jar RichfacesUI-Suggestionbox.patch

39a) cp richfaces-ui-3.3.4.Final-gov4j-2.jar ../../../../
39b) cp richfaces-ui-3.3.4.Final-gov4j-2.jar ../../../../../../jar/faces/richfaces-ui-3.3.4.Final-gov4j-2.jar

# Pulizia delle risorse utilizzate:

40) cd ../../../../
41) rm -rf richfaces-ui-3.3.4.Final/;








