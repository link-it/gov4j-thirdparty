4) cp JAVA/org/tp23/jgoodies/plaf/plastic/common/ShadowPopupMenuUtils.java JAR/org/tp23/jgoodies/plaf/plastic/common/
5) javac -classpath JAR JAR/org/tp23/jgoodies/plaf/plastic/common/ShadowPopupMenuUtils.java 
6) cp patch.README JAR
7) cd JAR;
8) rm -f ../jgoodies-edited-1.2.2-gov4j-1.jar; jar -cfM ../jgoodies-edited-1.2.2-gov4j-1.jar *; cd ..;
