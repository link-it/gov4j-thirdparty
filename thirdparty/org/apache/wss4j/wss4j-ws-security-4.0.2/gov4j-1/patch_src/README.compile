 NOTA: Usare java 17 e maven 3.9.x o superiore

wget https://archive.apache.org/dist/ws/wss4j/4.0.2/wss4j-4.0.2-source-release.zip
unzip -q wss4j-4.0.2-source-release.zip
patch -p0 < sorgenti_common.patch
patch -p0 < sorgenti_common_saml.patch
patch -p0 < sorgenti_dom.patch
patch -p0 < sorgenti_dom_attachment_mimetype.patch
cd wss4j-4.0.2
mvn clean install
cd ws-security-common/
mvn javadoc:javadoc
cd ..
cd ws-security-dom/
mvn javadoc:javadoc
cd ..
cd ..



