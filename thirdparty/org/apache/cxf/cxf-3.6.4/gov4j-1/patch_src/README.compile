 NOTA: Utilizzare java 11 come compilazione

wget https://archive.apache.org/dist/cxf/3.6.4/apache-cxf-3.6.4-src.tar.gz
tar xzf apache-cxf-3.6.4-src.tar.gz

patch -p0 < sorgenti.patch
cd apache-cxf-3.6.4-src/core/
mvn install
mvn javadoc:javadoc
cd ../../

patch -p0 < sorgenti_jose.patch
cd apache-cxf-3.6.4-src/rt/rs/security/jose-parent/jose
mvn install
mvn javadoc:javadoc
cd ../../../../../../
