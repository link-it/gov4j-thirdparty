+  private static void rewriteNullable(JsonNode node) {
+    if (node == null) {
+      return;
+    }
+    if (node.isObject()) {
+      ObjectNode obj = (ObjectNode) node;
+      JsonNode nullable = obj.remove("nullable");
+      if (nullable != null && nullable.isBoolean() && nullable.booleanValue()) {
+        JsonNode type = obj.get("type");
+        if (type != null) {
+          if (type.isTextual() && !"null".equals(type.textValue())) {
+            ArrayNode arr = JsonNodeFactory.instance.arrayNode();
+            arr.add(type.textValue());
+            arr.add("null");
+            obj.set("type", arr);
+          } else if (type.isArray()) {
+            ArrayNode arr = (ArrayNode) type;
+            boolean hasNull = false;
+            for (JsonNode el : arr) {
+              if (el.isTextual() && "null".equals(el.textValue())) {
+                hasNull = true;
+                break;
+              }
+            }
+            if (!hasNull) {
+              arr.add("null");
+            }
+          }
+        }
+      }
+      Iterator<JsonNode> it = obj.elements();
+      while (it.hasNext()) {
+        rewriteNullable(it.next());
+      }
+    } else if (node.isArray()) {
+      for (JsonNode el : node) {
+        rewriteNullable(el);
+      }
+    }
+  }
