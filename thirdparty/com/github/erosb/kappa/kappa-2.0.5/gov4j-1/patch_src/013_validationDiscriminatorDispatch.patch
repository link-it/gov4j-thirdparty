+  /**
+   * OAS-specific 'discriminator' shortcut: se lo schema del mediaType ha un 'discriminator' su
+   * 'oneOf'/'anyOf', seleziona il subschema target in base al valore del discriminator nel body
+   * e ritorna un validator costruito solo su quel subschema. Allineato a openapi4j (DiscriminatorValidator).
+   *
+   * <p>Il discriminator NON è parte di JSON Schema 2020-12: senza questo shortcut, json-sKema
+   * valuta tutti i subschema in 'oneOf'/'anyOf' come JSON Schema puro e può generare falsi positivi
+   * (ad es. tutti i subschema matchano quando hanno un parent comune e non vietano proprietà extra).</p>
+   *
+   * <p>Risoluzione del target:
+   *   <ul>
+   *     <li>explicit: {@code discriminator.mapping[value]} se presente;</li>
+   *     <li>implicit: il subschema con {@code $ref} che termina con il valore del discriminator
+   *         (es. {@code #/components/schemas/Cat} per valore {@code Cat}).</li>
+   *   </ul>
+   * </p>
+   *
+   * @return validator dedicato al subschema target, oppure {@code null} se non è applicabile lo shortcut
+   *         (nessun discriminator, body non-object, valore mancante, target non trovato)
+   *         e si deve usare il path standard.
+   */
+  private SKemaBackedJsonValidator dispatchDiscriminator(Object bodyAsValue) {
+    Schema schema = resolveRef(mediaType.getSchema());
+    if (schema == null) {
+      return null;
+    }
+    Discriminator discriminator = schema.getDiscriminator();
+    if (discriminator == null || discriminator.getPropertyName() == null) {
+      return null;
+    }
+    List<Schema> alternatives = schema.getOneOfSchemas();
+    if (alternatives == null || alternatives.isEmpty()) {
+      alternatives = schema.getAnyOfSchemas();
+    }
+    if (alternatives == null || alternatives.isEmpty()) {
+      return null;
+    }
+    String discriminatorValue = extractDiscriminatorValue(bodyAsValue, discriminator.getPropertyName());
+    if (discriminatorValue == null) {
+      return null;
+    }
+    Schema target = findTargetSchema(alternatives, discriminator.getMapping(), discriminatorValue);
+    if (target == null) {
+      return null;
+    }
+    return new SKemaBackedJsonValidator(target.copy(), context);
+  }
+
+  /**
+   * Dereferenzia uno schema $ref usando, nell'ordine:
+   *   - {@link Schema#getReference(com.github.erosb.kappa.core.model.OAIContext)} che usa canonicalRef (o ref) per cercare nel registry;
+   *   - in fallback, {@link com.github.erosb.kappa.core.model.reference.ReferenceRegistry#getRef(java.net.URL, String)} con baseUrl del contesto;
+   *   - in ultimo fallback, lookup diretto via JSON Pointer su {@link com.github.erosb.kappa.core.model.v3.OAI3Context#getBaseDocument()}
+   *     (necessario perché kappa non popola il registry per tutti i {@code $ref} interni alla spec).
+   * Ritorna lo schema invariato se nessuna strategia risolve.
+   */
+  private Schema resolveRef(Schema schema) {
+    if (schema == null || !schema.isRef()) {
+      return schema;
+    }
+    try {
+      Reference ref = schema.getReference(context.getContext());
+      if (ref == null) {
+        ref = context.getContext().getReferenceRegistry()
+            .getRef(context.getContext().getBaseUrl(), schema.getRef());
+      }
+      Schema resolved = (ref != null) ? ref.getMappedContent(Schema.class) : null;
+      if (resolved == null) {
+        String r = schema.getRef();
+        if (r != null && r.startsWith("#")) {
+          JsonNode baseDoc = context.getContext().getBaseDocument();
+          JsonNode node = (baseDoc != null) ? baseDoc.at(r.substring(1)) : null;
+          if (node != null && !node.isMissingNode()) {
+            resolved = com.github.erosb.kappa.core.util.TreeUtil.json.treeToValue(node, Schema.class);
+          }
+        }
+      }
+      return resolved != null ? resolved : schema;
+    } catch (Exception e) {
+      return schema;
+    }
+  }
+
+  private static String extractDiscriminatorValue(Object bodyAsValue, String propertyName) {
+    if (bodyAsValue instanceof JsonNode) {
+      JsonNode jn = (JsonNode) bodyAsValue;
+      if (!jn.isObject()) {
+        return null;
+      }
+      JsonNode prop = jn.get(propertyName);
+      return (prop != null && prop.isTextual()) ? prop.textValue() : null;
+    }
+    if (bodyAsValue instanceof com.github.erosb.jsonsKema.IJsonObject) {
+      com.github.erosb.jsonsKema.IJsonObject<?, ?> jo = (com.github.erosb.jsonsKema.IJsonObject<?, ?>) bodyAsValue;
+      Object prop = jo.get(propertyName);
+      if (prop instanceof com.github.erosb.jsonsKema.IJsonString) {
+        return ((com.github.erosb.jsonsKema.IJsonString) prop).getValue();
+      }
+    }
+    return null;
+  }
+
+  private static Schema findTargetSchema(List<Schema> alternatives,
+                                         Map<String, String> mapping,
+                                         String discriminatorValue) {
+    // explicit: discriminator.mapping[value] -> ref esatto
+    if (mapping != null) {
+      String mappedRef = mapping.get(discriminatorValue);
+      if (mappedRef != null) {
+        for (Schema alt : alternatives) {
+          if (alt.isRef() && mappedRef.equals(alt.getRef())) {
+            return alt;
+          }
+        }
+      }
+    }
+    // implicit: $ref che termina con il valore (es. #/components/schemas/Cat)
+    String suffix = "/" + discriminatorValue;
+    for (Schema alt : alternatives) {
+      if (alt.isRef() && alt.getRef() != null && alt.getRef().endsWith(suffix)) {
+        return alt;
+      }
+    }
+    return null;
+  }
