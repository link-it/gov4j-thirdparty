+    // 2) Walk in properties (oggetto schema)
+    Map<String, Schema> properties = schema.getProperties();
+    if (properties != null && !properties.isEmpty()) {
+      for (Map.Entry<String, Schema> e : properties.entrySet()) {
+        Object childBody = getProperty(body, e.getKey());
+        if (childBody != null) {
+          String childPath = path.isEmpty() ? e.getKey() : (path + "." + e.getKey());
+          walkDiscriminators(e.getValue(), childBody, validation, visited, childPath);
+        }
+      }
