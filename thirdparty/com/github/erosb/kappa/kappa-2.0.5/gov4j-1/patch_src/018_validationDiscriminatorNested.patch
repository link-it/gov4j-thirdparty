+        // ulteriormente annidati all'interno del target stesso). Per il caso skema-bridge non
+        // abbiamo Schema POJO target -> il walking si ferma qui (json-sKema farà la sua
+        // validazione standard sul subschema corretto).
+        if (targetPojo != null) {
