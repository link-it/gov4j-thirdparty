+  /**
+   * Estrae il nome "implicito" di uno schema referenziato via {@code $ref}, deducendolo
+   * dall'ultimo segmento del {@link com.github.erosb.jsonsKema.SourceLocation#getPointer()}.
+   * Per uno schema raggiunto via {@code $ref: "#/components/schemas/Cat2"} ritorna {@code "Cat2"}.
+   * Necessario perché json-sKema risolve i {@code $ref} durante il parsing producendo direttamente
+   * gli schema target (es. {@link com.github.erosb.jsonsKema.CompositeSchema}) anziché
+   * {@link com.github.erosb.jsonsKema.ReferenceSchema}: l'unica traccia del nome originale è il pointer.
+   */
+  private static String extractImplicitName(com.github.erosb.jsonsKema.Schema sk) {
+    if (sk == null) return null;
+    try {
+      com.github.erosb.jsonsKema.SourceLocation loc = sk.getLocation();
+      if (loc == null) return null;
+      Object pointer = loc.getPointer();
+      if (pointer == null) return null;
+      String s = pointer.toString();
+      if (s == null || s.isEmpty()) return null;
+      int slash = s.lastIndexOf('/');
+      return (slash >= 0 && slash < s.length() - 1) ? s.substring(slash + 1) : s;
+    } catch (Exception e) {
+      return null;
+    }
+  }
+
+  /**
+   * Variante di {@link #findTargetSchema(List, Map, String)} per il caso skema-bridge.
+   *
+   * <p>json-sKema risolve i {@code $ref} durante il parsing producendo direttamente gli schema
+   * target (tipicamente {@link com.github.erosb.jsonsKema.CompositeSchema}); per individuare il
+   * target del discriminator usiamo due strategie complementari:</p>
+   *
+   * <ul>
+   *   <li><b>explicit mapping</b> ({@code mapping} non-vuoto): è sufficiente verificare che
+   *       {@code discriminatorValue} sia tra le chiavi del {@code mapping}. Se lo è, json-sKema
+   *       valuterà comunque il subschema corretto durante la validazione standard e qui basta
+   *       confermare che la mappatura del valore esista. Se non lo è, il valore non è associato
+   *       a nessun subschema -&gt; violation.</li>
+   *   <li><b>implicit</b> (senza {@code mapping}): confrontiamo {@code discriminatorValue} con
+   *       il nome "implicito" di ciascun alternative, estratto dall'ultimo segmento del
+   *       {@link com.github.erosb.jsonsKema.SourceLocation#getPointer() pointer}
+   *       (es. {@code "#/components/schemas/Cat"} -&gt; {@code "Cat"}). Per le schema risolte
+   *       inline il nome è {@code null} e si lascia il dubbio a json-sKema (return true).</li>
+   * </ul>
+   */
+  private static boolean findTargetRefInBridge(java.util.List<com.github.erosb.jsonsKema.Schema> alternatives,
+                                               Map<String, String> mapping,
+                                               String discriminatorValue) {
+    if (mapping != null && !mapping.isEmpty()) {
+      return mapping.containsKey(discriminatorValue);
+    }
+    boolean anyInlineCandidate = false;
+    for (com.github.erosb.jsonsKema.Schema alt : alternatives) {
+      String name = extractImplicitName(alt);
+      if (name == null) {
+        anyInlineCandidate = true;
+        continue;
+      }
+      if (name.equals(discriminatorValue)) {
+        return true;
+      }
+    }
+    return anyInlineCandidate;
+  }
+
+  /**
+   * Costruisce un {@link Discriminator} kappa da un valore json-sKema {@code IJsonObject} estratto
+   * da {@code unprocessedProperties["discriminator"]}. Tollera assenze di {@code propertyName} e
+   * {@code mapping}.
+   */
+  private static Discriminator buildDiscriminatorFromJsonValue(com.github.erosb.jsonsKema.IJsonValue value) {
+    if (!(value instanceof com.github.erosb.jsonsKema.IJsonObject)) {
+      return null;
+    }
+    com.github.erosb.jsonsKema.IJsonObject<?, ?> obj = (com.github.erosb.jsonsKema.IJsonObject<?, ?>) value;
+    Discriminator d = new Discriminator();
+    Object propName = obj.get("propertyName");
+    if (propName instanceof com.github.erosb.jsonsKema.IJsonString) {
+      d.setPropertyName(((com.github.erosb.jsonsKema.IJsonString) propName).getValue());
+    }
+    Object mapping = obj.get("mapping");
+    if (mapping instanceof com.github.erosb.jsonsKema.IJsonObject) {
+      com.github.erosb.jsonsKema.IJsonObject<?, ?> mapObj = (com.github.erosb.jsonsKema.IJsonObject<?, ?>) mapping;
+      java.util.Map<String, String> javaMap = new java.util.LinkedHashMap<>();
+      for (Map.Entry<?, ?> me : mapObj.getProperties().entrySet()) {
+        Object k = me.getKey();
+        Object v = me.getValue();
+        String keyStr = (k instanceof com.github.erosb.jsonsKema.IJsonString)
+            ? ((com.github.erosb.jsonsKema.IJsonString) k).getValue() : String.valueOf(k);
+        String valStr = (v instanceof com.github.erosb.jsonsKema.IJsonString)
+            ? ((com.github.erosb.jsonsKema.IJsonString) v).getValue() : String.valueOf(v);
+        javaMap.put(keyStr, valStr);
+      }
+      d.setMapping(javaMap);
+    }
+    return d;
+  }
