+  /**
+   * Coppia {@code (discriminator, alternativeRefs)} estratta da un
+   * {@link com.github.erosb.jsonsKema.CompositeSchema} quando lo Schema POJO non popola i field
+   * tradizionali (caso degli schemi inline nested). Gli alternative sono espressi come liste di
+   * stringhe {@code $ref} (es. {@code "#/components/schemas/Cat2"}) perché il setter
+   * {@code Schema.setRef} non è accessibile dal nostro package.
+   */
+  private static final class DiscriminatorFromBridge {
+    final Discriminator discriminator;
+    final java.util.List<com.github.erosb.jsonsKema.Schema> alternatives;
+
+    DiscriminatorFromBridge(Discriminator discriminator, java.util.List<com.github.erosb.jsonsKema.Schema> alternatives) {
+      this.discriminator = discriminator;
+      this.alternatives = alternatives;
+    }
+  }
+
+  /**
+   * Cerca {@code discriminator}/{@code oneOf}/{@code anyOf} dentro il bridge {@code skema}
+   * (json-sKema) associato a uno Schema POJO. Necessario per schemi inline nested dove i field
+   * tradizionali non sono popolati. Ritorna {@code null} se {@code skema} non è un CompositeSchema
+   * oppure se non contiene né un discriminator né un oneOf/anyOf.
+   */
+  private static DiscriminatorFromBridge extractDiscriminatorFromSkema(Schema schema) {
+    if (schema == null) {
+      return null;
+    }
+    com.github.erosb.jsonsKema.Schema sk = schema.getSkema();
+    if (!(sk instanceof com.github.erosb.jsonsKema.CompositeSchema)) {
+      return null;
+    }
+    com.github.erosb.jsonsKema.CompositeSchema composite = (com.github.erosb.jsonsKema.CompositeSchema) sk;
+
+    Discriminator discriminator = null;
+    Map<com.github.erosb.jsonsKema.IJsonString, com.github.erosb.jsonsKema.IJsonValue> unprocessed = composite.getUnprocessedProperties();
+    if (unprocessed != null) {
+      for (Map.Entry<com.github.erosb.jsonsKema.IJsonString, com.github.erosb.jsonsKema.IJsonValue> e : unprocessed.entrySet()) {
+        if ("discriminator".equals(e.getKey().getValue())) {
+          discriminator = buildDiscriminatorFromJsonValue(e.getValue());
+          break;
+        }
+      }
+    }
+
+    java.util.List<com.github.erosb.jsonsKema.Schema> alternatives = null;
+    java.util.Set<com.github.erosb.jsonsKema.Schema> subs = composite.getSubschemas();
+    if (subs != null) {
+      for (com.github.erosb.jsonsKema.Schema sub : subs) {
+        java.util.List<com.github.erosb.jsonsKema.Schema> candidates = null;
+        if (sub instanceof com.github.erosb.jsonsKema.OneOfSchema) {
+          candidates = ((com.github.erosb.jsonsKema.OneOfSchema) sub).getSubschemas();
+        } else if (sub instanceof com.github.erosb.jsonsKema.AnyOfSchema) {
+          candidates = ((com.github.erosb.jsonsKema.AnyOfSchema) sub).getSubschemas();
+        }
+        if (candidates != null && !candidates.isEmpty()) {
+          alternatives = new java.util.ArrayList<>(candidates);
+          break;
+        }
+      }
+    }
+
+    if (discriminator == null && (alternatives == null || alternatives.isEmpty())) {
+      return null;
+    }
+    return new DiscriminatorFromBridge(discriminator, alternatives);
+  }
