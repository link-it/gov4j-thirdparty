+   * <p>Per gli schemi nested inline lo Schema POJO non popola i field tradizionali
+   * ({@code discriminator}/{@code oneOfSchemas}): l'informazione viene allora estratta dal bridge
+   * {@code skema} (json-sKema {@link com.github.erosb.jsonsKema.CompositeSchema}).</p>
+   */
+  private void validateAllDiscriminators(Schema schema, Object body, ValidationData<?> validation) {
+    if (schema == null || body == null) {
+      return;
+    }
+    walkDiscriminators(schema, body, validation, new java.util.IdentityHashMap<>(), "");
+  }
