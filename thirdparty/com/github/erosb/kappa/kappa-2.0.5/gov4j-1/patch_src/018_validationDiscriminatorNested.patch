+   *             (vuoto al root, es. {@code "allegati.0.documento"} dopo aver attraversato
+   *             {@code properties.allegati} + {@code items[0]} + {@code properties.documento}).
+   */
+  private void walkDiscriminators(Schema schema, Object body, ValidationData<?> validation,
+                                  java.util.IdentityHashMap<Schema, Boolean> visited,
+                                  String path) {
+    schema = resolveRef(schema);
+    if (schema == null || visited.containsKey(schema)) {
+      return;
+    }
+    visited.put(schema, Boolean.TRUE);
+
+    // 1) Discriminator sul nodo corrente
+    // Lo Schema POJO popola 'discriminator' + 'oneOfSchemas' solo per schemi top-level o
+    // referenziati ($ref) deserializzati da Jackson convertValue. Per i sotto-schemi nested inline
+    // (es. 'metadati.pet' definito inline in un body multipart) lo Schema viene costruito via
+    // {@code new Schema(skema)} dal visitor di {@link Schema#getProperties()}: i field
+    // tradizionali restano vuoti e l'info finisce dentro {@code skema} (CompositeSchema), con il
+    // discriminator in {@code unprocessedProperties["discriminator"]} e gli alternative come
+    // sub-istanze {@link com.github.erosb.jsonsKema.OneOfSchema}/{@link com.github.erosb.jsonsKema.AnyOfSchema}.
+    Discriminator discriminator = schema.getDiscriminator();
+    List<Schema> alternatives = schema.getOneOfSchemas();
+    if (alternatives == null || alternatives.isEmpty()) {
+      alternatives = schema.getAnyOfSchemas();
+    }
+    java.util.List<com.github.erosb.jsonsKema.Schema> bridgeAlternatives = null;
+    if ((discriminator == null || discriminator.getPropertyName() == null)
+        || alternatives == null || alternatives.isEmpty()) {
+      DiscriminatorFromBridge fromBridge = extractDiscriminatorFromSkema(schema);
+      if (fromBridge != null) {
+        if (discriminator == null || discriminator.getPropertyName() == null) {
+          discriminator = fromBridge.discriminator;
+        }
+        if (alternatives == null || alternatives.isEmpty()) {
+          bridgeAlternatives = fromBridge.alternatives;
+        }
+      }
+    }
+    // Il discriminator è meaningful solo accoppiato a oneOf/anyOf. Per schemi con discriminator
+    // SENZA composizione (es. Pet OAS 3.0 parent allOf-based), saltiamo silenziosamente: la
+    // composizione effettiva è dichiarata dai sub-schemi figli che lo referenziano via allOf,
+    // e l'eventuale violation verrà segnalata dalla validazione di schema standard.
+    boolean hasAlternativesPojo = (alternatives != null && !alternatives.isEmpty());
+    boolean hasAlternativesBridge = (bridgeAlternatives != null && !bridgeAlternatives.isEmpty());
+    if (discriminator != null && discriminator.getPropertyName() != null
+        && (hasAlternativesPojo || hasAlternativesBridge)) {
+      String value = extractDiscriminatorValue(body, discriminator.getPropertyName());
+      if (value != null) {
