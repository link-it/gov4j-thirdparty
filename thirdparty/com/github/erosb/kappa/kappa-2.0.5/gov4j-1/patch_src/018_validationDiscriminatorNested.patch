+  private static Object getProperty(Object body, String name) {
+    if (body instanceof JsonNode) {
+      JsonNode jn = (JsonNode) body;
+      if (!jn.isObject()) {
+        return null;
+      }
+      JsonNode v = jn.get(name);
+      return (v != null && !v.isMissingNode() && !v.isNull()) ? v : null;
+    }
+    if (body instanceof com.github.erosb.jsonsKema.IJsonObject) {
+      com.github.erosb.jsonsKema.IJsonObject<?, ?> jo = (com.github.erosb.jsonsKema.IJsonObject<?, ?>) body;
+      return jo.get(name);
+    }
+    return null;
+  }
+
+  private static int arraySize(Object body) {
+    if (body instanceof JsonNode) {
+      JsonNode jn = (JsonNode) body;
+      return jn.isArray() ? jn.size() : 0;
+    }
+    if (body instanceof com.github.erosb.jsonsKema.IJsonArray) {
+      return ((com.github.erosb.jsonsKema.IJsonArray<?>) body).length();
+    }
+    return 0;
+  }
+
+  private static Object arrayElement(Object body, int index) {
+    if (body instanceof JsonNode) {
+      JsonNode jn = (JsonNode) body;
+      return jn.isArray() ? jn.get(index) : null;
+    }
+    if (body instanceof com.github.erosb.jsonsKema.IJsonArray) {
+      return ((com.github.erosb.jsonsKema.IJsonArray<?>) body).get(index);
+    }
+    return null;
+  }
