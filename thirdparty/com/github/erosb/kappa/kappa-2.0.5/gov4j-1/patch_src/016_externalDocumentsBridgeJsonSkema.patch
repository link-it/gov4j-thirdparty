+  /**
+   * Costruisce un singolo nodo 'components' fondendo i 'components' di tutti i documenti registrati
+   * nell'OAI3Context (master + allegati). Il master ha precedenza in caso di chiavi duplicate.
+   */
+  private static JsonNode buildMergedComponents(ValidationContext<OAI3> context) {
+    ObjectNode merged = JsonNodeFactory.instance.objectNode();
+    JsonNode masterComponents = context.getContext().getBaseDocument().get("components");
+    Map<String, JsonNode> registry = context.getContext().getDocumentRegistry();
+    if (registry != null) {
+      for (JsonNode doc : registry.values()) {
+        JsonNode comps = doc.get("components");
+        if (comps != null && comps.isObject()) {
+          mergeComponentSection(merged, (ObjectNode) comps);
+        }
+      }
+    }
+    // Master per ultimo cosi' ha precedenza (sovrascrive eventuali duplicati dagli allegati).
+    if (masterComponents != null && masterComponents.isObject()) {
+      mergeComponentSection(merged, (ObjectNode) masterComponents);
+    }
+    return merged;
+  }
+
+  /** Merge depth-2: per ogni sezione (schemas, responses, parameters, ...) fonde le entry. */
+  private static void mergeComponentSection(ObjectNode merged, ObjectNode src) {
+    Iterator<Map.Entry<String, JsonNode>> sections = src.fields();
+    while (sections.hasNext()) {
+      Map.Entry<String, JsonNode> section = sections.next();
+      String sectionName = section.getKey();
+      JsonNode sectionValue = section.getValue();
+      if (!(sectionValue instanceof ObjectNode)) {
+        continue;
+      }
+      ObjectNode mergedSection;
+      if (merged.has(sectionName) && merged.get(sectionName) instanceof ObjectNode) {
+        mergedSection = (ObjectNode) merged.get(sectionName);
+      } else {
+        mergedSection = JsonNodeFactory.instance.objectNode();
+        merged.set(sectionName, mergedSection);
+      }
+      Iterator<Map.Entry<String, JsonNode>> entries = sectionValue.fields();
+      while (entries.hasNext()) {
+        Map.Entry<String, JsonNode> entry = entries.next();
+        mergedSection.set(entry.getKey(), entry.getValue());
+      }
+    }
+  }
+
+  /**
+   * Riscrive $ref cross-file (es. 'foo.yaml#/components/schemas/X') in $ref locali ('#/components/schemas/X'),
+   * grazie alla fusione di components in {@link #buildMergedComponents}. Tocca anche 'abs$ref' iniettato
+   * dal ReferenceResolver di kappa.
+   */
+  private static void rewriteCrossFileRefs(JsonNode node) {
+    if (node == null) {
+      return;
+    }
+    if (node.isObject()) {
+      ObjectNode obj = (ObjectNode) node;
+      stripPathFromRefField(obj, "$ref");
+      stripPathFromRefField(obj, "abs$ref");
+      Iterator<Map.Entry<String, JsonNode>> it = obj.fields();
+      while (it.hasNext()) {
+        rewriteCrossFileRefs(it.next().getValue());
+      }
+    } else if (node.isArray()) {
+      for (JsonNode el : node) {
+        rewriteCrossFileRefs(el);
+      }
+    }
+  }
+
+  private static void stripPathFromRefField(ObjectNode obj, String fieldName) {
+    JsonNode refNode = obj.get(fieldName);
+    if (refNode == null || !refNode.isTextual()) {
+      return;
+    }
+    String ref = refNode.textValue();
+    int idx = ref.indexOf('#');
+    if (idx <= 0) {
+      // ref puramente locale (#/...) o senza '#': nulla da riscrivere
+      return;
+    }
+    String pointer = ref.substring(idx); // include '#'
+    // Riscriviamo SOLO i ref che puntano a una sezione 'components/...' (caso OAS),
+    // perche' la fusione precedente li ha resi disponibili nel rawJson sotto 'components/...'.
+    // I ref a schemi top-level di un sub-document (es. '#/Id' in uno schema JSON Schema
+    // legacy) non sono fusi e devono restare invariati per non rompere la risoluzione.
+    if (pointer.startsWith("#/components/")) {
+      obj.set(fieldName, JsonNodeFactory.instance.textNode(pointer));
+    }
+  }
