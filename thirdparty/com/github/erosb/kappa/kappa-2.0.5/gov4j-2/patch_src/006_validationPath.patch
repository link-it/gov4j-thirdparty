+  /**
+   * Decodes a percent-encoded path segment using UTF-8.
+   * URLDecoder also turns '+' into ' ', which in the path component is not the
+   * standard meaning ('+' is a literal there); pre-escape it so the decoder
+   * leaves it untouched.
+   */
+  private static String decodePathSegment(String value) {
+    if (value == null) {
+      return null;
+    }
+    try {
+      return URLDecoder.decode(value.replace("+", "%2B"), StandardCharsets.UTF_8.name());
+    } catch (UnsupportedEncodingException e) {
+      return value;
+    }
+  }
