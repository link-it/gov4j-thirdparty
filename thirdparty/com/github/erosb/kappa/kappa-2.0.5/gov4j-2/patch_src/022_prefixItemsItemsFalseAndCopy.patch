+  /**
+   * Workaround per il bug di json-sKema 0.30 sulla combinazione {@code prefixItems + items: false}:
+   * la libreria applica {@code items: false} a TUTTI gli indici dell'array, anche quelli coperti
+   * da {@code prefixItems}, producendo {@code body.<i>: false schema always fails} su tuple
+   * formalmente valide. La semantica OAS 3.1 / JSON Schema 2020-12 prevede invece che
+   * {@code items: false} si applichi solo agli indici extra (oltre la lunghezza di
+   * {@code prefixItems}); quindi e' equivalente a {@code maxItems: <len(prefixItems)>}, che
+   * json-sKema implementa correttamente. Sostituiamo la coppia ricorsivamente sull'intero schema.
+   */
+  private static void rewritePrefixItemsWithItemsFalse(JsonNode node) {
+    if (node == null) {
+      return;
+    }
+    if (node.isObject()) {
+      ObjectNode obj = (ObjectNode) node;
+      JsonNode prefixItems = obj.get("prefixItems");
+      JsonNode items = obj.get("items");
+      if (prefixItems != null && prefixItems.isArray()
+          && items != null && items.isBoolean() && !items.booleanValue()) {
+        int n = prefixItems.size();
+        obj.remove("items");
+        // mantieni il maxItems gia' presente se piu' restrittivo, altrimenti imposta quello derivato
+        JsonNode existingMax = obj.get("maxItems");
+        if (existingMax == null || !existingMax.isNumber() || existingMax.asInt() > n) {
+          obj.put("maxItems", n);
+        }
+      }
+      Iterator<JsonNode> it = obj.elements();
+      while (it.hasNext()) {
+        rewritePrefixItemsWithItemsFalse(it.next());
+      }
+    } else if (node.isArray()) {
+      for (JsonNode el : node) {
+        rewritePrefixItemsWithItemsFalse(el);
+      }
+    }
+  }
