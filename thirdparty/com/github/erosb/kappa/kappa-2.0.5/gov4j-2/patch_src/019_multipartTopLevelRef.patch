+  /**
+   * Dereferenzia uno schema $ref top-level cercando, nell'ordine: il registry kappa
+   * ({@link com.github.erosb.kappa.core.model.v3.OAI3Context#getReferenceRegistry()}) tramite il
+   * canonical/ref dichiarato, e in fallback un lookup JSON-pointer diretto sul baseDocument
+   * (necessario perché kappa non popola il registry per tutti i {@code $ref} interni alla spec).
+   * Se lo schema non è un $ref, lo ritorna invariato. In caso di errore o ref non risolvibile
+   * ritorna lo schema originale (il chiamante gestirà properties=null con null-check difensivo).
+   */
+  private static Schema resolveRefIfNeeded(Schema schema, OAIContext context) {
+    if (schema == null || !schema.isRef()) {
+      return schema;
+    }
+    if (!(context instanceof com.github.erosb.kappa.core.model.v3.OAI3Context)) {
+      return schema;
+    }
+    com.github.erosb.kappa.core.model.v3.OAI3Context ctx = (com.github.erosb.kappa.core.model.v3.OAI3Context) context;
+    try {
+      com.github.erosb.kappa.core.model.reference.Reference ref = schema.getReference(ctx);
+      if (ref == null) {
+        ref = ctx.getReferenceRegistry().getRef(ctx.getBaseUrl(), schema.getRef());
+      }
+      Schema resolved = (ref != null) ? ref.getMappedContent(Schema.class) : null;
+      if (resolved == null) {
+        String r = schema.getRef();
+        if (r != null && r.startsWith("#")) {
+          JsonNode baseDoc = ctx.getBaseDocument();
+          JsonNode node = (baseDoc != null) ? baseDoc.at(r.substring(1)) : null;
+          if (node != null && !node.isMissingNode()) {
+            resolved = TreeUtil.json.treeToValue(node, Schema.class);
+          }
+        }
+      }
+      return resolved != null ? resolved : schema;
+    } catch (Exception e) {
+      return schema;
+    }
+  }
