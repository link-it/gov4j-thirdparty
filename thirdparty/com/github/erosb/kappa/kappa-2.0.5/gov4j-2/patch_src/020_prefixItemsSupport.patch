+   * implementa il keyword {@code prefixItems} (vedi log {@code [KAPPA-SKEMA] schema=...subschemas
+   * non include PrefixItemsSchema}) e quindi non emette di per se' il mismatch di tipo elemento
+   * per elemento. Per ogni indice i &lt; |prefixItems| confronta il tipo del JsonNode con
+   * {@code prefixItems[i].type}; se non matcha emette
+   * {@link OpenApiValidationFailure#prefixItemsTypeMismatch}.
+   *
+   * <p>No-op se lo schema del parametro non ha {@code prefixItems} (non altera il comportamento
+   * dei parametri privi del costrutto).</p>
+   */
+  private void validatePrefixItems(String paramName,
+                                   AbsParameter<M> param,
+                                   JsonNode paramValue,
+                                   ValidationData<?> validation) {
+    if (param == null || param.getSchema() == null || paramValue == null || !paramValue.isArray()) {
+      return;
+    }
+    java.util.List<Schema> prefixItems = param.getSchema().getPrefixItemsSchemas();
+    if (prefixItems == null || prefixItems.isEmpty()) {
+      return;
+    }
+    com.fasterxml.jackson.databind.node.ArrayNode arr = (com.fasterxml.jackson.databind.node.ArrayNode) paramValue;
+    int bound = Math.min(arr.size(), prefixItems.size());
+    for (int i = 0; i < bound; i++) {
+      Schema elemSchema = prefixItems.get(i);
+      if (elemSchema == null) continue;
+      String expectedType = elemSchema.getSupposedType(context.getContext());
+      if (expectedType == null) continue;
+      JsonNode el = arr.get(i);
+      if (!matchesType(el, expectedType)) {
+        String actualType = jsonNodeTypeName(el);
+        validation.add(OpenApiValidationFailure.prefixItemsTypeMismatch(
+          paramName, i, expectedType, actualType,
+          context.requestScopedUriFactory().definitionPath()));
+      }
+    }
+  }
+
+  private static boolean matchesType(JsonNode node, String oasType) {
+    if (node == null || node.isNull()) {
+      return "null".equals(oasType);
+    }
+    switch (oasType) {
+      case "integer": return node.isIntegralNumber();
+      case "number":  return node.isNumber();
+      case "string":  return node.isTextual();
+      case "boolean": return node.isBoolean();
+      case "array":   return node.isArray();
+      case "object":  return node.isObject();
+      default:        return true;
+    }
+  }
+
+  private static String jsonNodeTypeName(JsonNode node) {
+    if (node == null || node.isNull())   return "null";
+    if (node.isIntegralNumber())         return "integer";
+    if (node.isNumber())                 return "number";
+    if (node.isTextual())                return "string";
+    if (node.isBoolean())                return "boolean";
+    if (node.isArray())                  return "array";
+    if (node.isObject())                 return "object";
+    return node.getNodeType().toString().toLowerCase();
+  }
