+  /**
+   * Dereferenzia uno schema {@code $ref} top-level cercando, nell'ordine: il registry kappa
+   * ({@link com.github.erosb.kappa.core.model.v3.OAI3Context#getReferenceRegistry()}) tramite il
+   * canonical/ref dichiarato, e in fallback un lookup JSON-pointer diretto sul baseDocument.
+   * Se lo schema non e' un {@code $ref}, oppure il ref non risolve, ritorna {@code this}.
+   *
+   * <p>Necessario quando lo Schema POJO ha solo il campo {@code ref} valorizzato e
+   * {@code properties}/{@code types}/etc. sono {@code null}: tipicamente accade per parametri
+   * dichiarati come {@code schema: { $ref: '#/components/schemas/X' }}. I caller che accedono
+   * a {@code getProperties()}/{@code getProperty()} devono dereferenziare prima per evitare
+   * NPE o falsi negativi ("Missing required parameter X" sui parametri object con explode=true
+   * e su {@code style: deepObject}).</p>
+   */
+  public Schema dereference(OAIContext context) {
+    if (!isRef()) {
+      return this;
+    }
+    if (!(context instanceof com.github.erosb.kappa.core.model.v3.OAI3Context)) {
+      return this;
+    }
+    com.github.erosb.kappa.core.model.v3.OAI3Context ctx = (com.github.erosb.kappa.core.model.v3.OAI3Context) context;
+    try {
+      com.github.erosb.kappa.core.model.reference.Reference ref = getReference(ctx);
+      if (ref == null) {
+        ref = ctx.getReferenceRegistry().getRef(ctx.getBaseUrl(), getRef());
+      }
+      Schema resolved = (ref != null) ? ref.getMappedContent(Schema.class) : null;
+      if (resolved == null) {
+        String r = getRef();
+        if (r != null && r.startsWith("#")) {
+          JsonNode baseDoc = ctx.getBaseDocument();
+          JsonNode node = (baseDoc != null) ? baseDoc.at(r.substring(1)) : null;
+          if (node != null && !node.isMissingNode()) {
+            resolved = TreeUtil.json.treeToValue(node, Schema.class);
+          }
+        }
+      }
+      return resolved != null ? resolved : this;
+    } catch (Exception e) {
+      return this;
+    }
+  }
